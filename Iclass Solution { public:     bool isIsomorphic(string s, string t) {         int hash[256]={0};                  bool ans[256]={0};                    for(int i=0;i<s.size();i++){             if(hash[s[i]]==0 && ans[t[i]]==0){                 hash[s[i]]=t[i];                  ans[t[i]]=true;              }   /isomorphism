class Solution {
public:
    bool isIsomorphic(string s, string t) {
        int hash[256]={0};
        
        bool ans[256]={0};
         

        for(int i=0;i<s.size();i++){
            if(hash[s[i]]==0 && ans[t[i]]==0){
                hash[s[i]]=t[i];
                 ans[t[i]]=true;

            }


// dubara value na jae iske lie \


        }
         for(int i=0;i<s.size();i++){
            if(hash[s[i]]!=t[i]){
                return false;
            }
         }
            return true;

        
    }
};
